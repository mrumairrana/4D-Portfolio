# ---------------------------------------------------------------------------
# Copy this file to `.env`. `.env*` is gitignored.
#
# EmailJS Configuration (for contact form)
# Get these from https://www.emailjs.com/
# ---------------------------------------------------------------------------

# EmailJS Public Key
EMAILJS_PUBLIC_KEY=sC-sT6eZUv0vJDb3c

# EmailJS Private Key (required for server-side API)
EMAILJS_PRIVATE_KEY=your-emailjs-private-key

# EmailJS Service ID
EMAILJS_SERVICE_ID=mailumairrana

# EmailJS Template ID
EMAILJS_TEMPLATE_ID=template_7lq3m4i

# Your email address (where to receive form submissions)
EMAILJS_TO_EMAIL=mailumairrana@gmail.com

# ---------------------------------------------------------------------------
# Optional: Site Configuration
# ---------------------------------------------------------------------------

# Your live domain, no trailing slash. Drives the sitemap, robots.txt, canonical
# URL and every Open Graph image URL. Leave it unset locally.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Optional. Google Search Console verification token, the `content` value of the
# google-site-verification meta tag. Leave it unset and the tag is not rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
